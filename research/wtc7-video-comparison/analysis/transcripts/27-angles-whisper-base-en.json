			"timestamps": {
				"from": "00:11:08,700",
				"to": "00:11:13,700"
			},
			"offsets": {
				"from": 668700,
				"to": 673700
			},
			"text": " And the dust from it is not unlike that from a volcano."
		},
		{
			"timestamps": {
				"from": "00:11:13,700",
				"to": "00:11:21,700"
			},
			"offsets": {
				"from": 673700,
				"to": 681700
			},
			"text": " We are on the phone with the New York Fire Department Lieutenant, David Restuchio Lieutenant, where are you right now?"
		},
