		{
			"timestamps": {
				"from": "00:11:00,700",
				"to": "00:11:03,700"
			},
			"offsets": {
				"from": 660700,
				"to": 663700
			},
			"text": " This was a 40-story building, they've been watching all day."
		},
		{
			"timestamps": {
				"from": "00:11:03,700",
				"to": "00:11:08,700"
			},
			"offsets": {
				"from": 663700,
				"to": 668700
			},
			"text": " This is like watching the collapse of an active volcano."
		},
