<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Index of //</title>
    <!-- External CSS file -->
    <link rel="stylesheet" href="/od/css/style.css" />
</head>

<body>
     <header>
        <div class="wrapper">
            <div class="breadcrumbs">
                Current Path
            </div>
            <h1>
               <span>//</span>
            </h1>
        </div>
    </header>

    <div class="wrapper">
        <div class="counts">
            <span><span class="number">0</span> directories</span>,
            <span><span class="number">0</span> files</span>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th class="size">Size</th>
                        <th class="modified">Modified</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Parent directory link -->
                    <tr>
                        <td><a href="../">../</a></td>
                        <td></td>
                        <td></td>
                    </tr>

                    <!-- Directory or file entries -->
                    

                </tbody>
            </table>
        </div>
    </div>
</body>

</html>